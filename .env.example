# 이 파일을 .env 로 복사하고 값을 채운다. .env 는 git 에 올라가지 않는다.
# 값은 팀 담당자에게 받는다 (사내 보안 자료).
DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=NEOE

# 선택 — 부하 장치 조정 (기본값이 적당하면 비워 둔다)
# HHHS_QUERY_TIMEOUT=60      # 쿼리 1건 제한시간(초)
# HHHS_MAX_ROWS=10000        # 결과 행 상한 (0 = 무제한)
# HHHS_COOLDOWN=1            # 느린 쿼리 뒤 자동 휴지 (0 = 끔)
# HHHS_HEAVY_ROWS=1000000    # 이 행수 이상이면 조건 없는 조회 차단
